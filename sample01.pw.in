 &CONTROL
   calculation     = 'scf'
   outdir          = './out/'
   wfcdir          = './out/'
   pseudo_dir      = './pseudo/'
   prefix          = 'sample01'
   disk_io         = 'high'
   verbosity       = 'high'
   tstress         = .true.
   tprnfor         = .true.
 /
 &SYSTEM
   ibrav           = 14
   A               = 4.26
   B               = 4.26
   C               = 8.52
   cosAB           = -0.5
   cosAC           = 0
   cosBC           = 0
   nat             = 6
   ntyp            = 1
   ecutwfc         = 65
   ecutrho         = 260
   occupations     = 'smearing'
   degauss         = 0.02
   smearing        = 'gaussian'
   noncolin        = .true.
   lspinorb        = .true.
 /
 &ELECTRONS
   electron_maxstep = 100
   conv_thr        = 1.D-9
 /
ATOMIC_SPECIES
    C   12.00000  C.rel-pz-n-rrkjus_psl.0.1.UPF
ATOMIC_POSITIONS angstrom
    C      1.420000000    0.000000000    0.000000000
    C      2.840000000    0.000000000    0.000000000
    C     -0.710000000    1.229600000    0.000000000
    C     -1.420000000    2.459300000    0.000000000
    C      0.710000000    1.229600000    0.000000000
    C      1.420000000    2.459300000    0.000000000
K_POINTS automatic
  8 8 8   1 1 1
